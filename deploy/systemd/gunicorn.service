[Unit]
Description=Gunicorn daemon for Legitcheck
Wants=network-online.target legitcheck-tg-tunnel.service
After=network-online.target legitcheck-tg-tunnel.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/legitcheck
EnvironmentFile=/etc/legitcheck/legitcheck.env
ExecStart=/root/legitcheck/env/bin/gunicorn \
  --access-logfile - \
  --error-logfile - \
  --worker-tmp-dir /dev/shm \
  --workers 3 \
  --threads 2 \
  --timeout 45 \
  --graceful-timeout 30 \
  --keep-alive 5 \
  --max-requests 1000 \
  --max-requests-jitter 100 \
  --bind unix:/run/gunicorn.sock \
  legitcheck.wsgi:application
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
