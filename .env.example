DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
LOCAL_DEV=0
DJANGO_ALLOWED_HOSTS=89.169.2.234,legitcheck.one,www.legitcheck.one,checkerlegit.com,www.checkerlegit.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://legitcheck.one,https://www.legitcheck.one,https://checkerlegit.com,https://www.checkerlegit.com
PUBLIC_BASE_URL=https://legitcheck.one

TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE=600
TRUSTED_PROXY_IPS=127.0.0.1,::1
# One-shot incident response switch. Set to 1 for the first secure deploy,
# then return to 0 after every persistent user bearer token has been rotated.
ROTATE_USER_AUTH_TOKENS=0
TELEGRAM_VERDICT_CHAT_ID=
# Separate checker groups. The legacy chat above is used as a fallback.
TELEGRAM_VERDICT_CHAT_15_30M_ID=
TELEGRAM_VERDICT_CHAT_1H_ID=
TELEGRAM_VERDICT_CHAT_2H_ID=
TELEGRAM_VERDICT_CHAT_3H_ID=
TELEGRAM_VERDICT_CHAT_12H_ID=
TELEGRAM_API_PROXY=http://proxy-user:proxy-password@127.0.0.1:33886

YOOKASSA_ACCOUNT_ID=
YOOKASSA_SECRET_KEY=
# Set only when the YooKassa shop uses multiple tax systems (1-6).
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_RETURN_URL=https://legitcheck.one/payment/success/

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LegitCheck <noreply@example.com>

# Optional App Store Review demo account. Disabled if email or password is empty.
APP_REVIEW_DEMO_EMAIL=
APP_REVIEW_DEMO_PASSWORD=
APP_REVIEW_DEMO_BALANCE=5000

# Web Push (installed PWA). Existing VKCHAT_VAPID_* values remain supported.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_CLAIM_EMAIL=admin@legitcheck.one

# Native App Store push (APNs token authentication).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
APNS_BUNDLE_ID=com.markor.legitcheck
APNS_USE_SANDBOX=0
