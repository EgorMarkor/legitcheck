# Copy to .env and fill in real values. Never commit .env to git.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=0          # set to 1 only on local dev (same effect as LOCAL_DEV=1)

# Local development only (disables HTTPS cookie flags, uses http://127.0.0.1:8000 as base URL)
LOCAL_DEV=0

# Public-facing URL (used in payment return links, bot messages, etc.)
PUBLIC_BASE_URL=https://legitcheck.one

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_VERDICT_CHAT_ID=replace-with-chat-id

# YooKassa
YOOKASSA_ACCOUNT_ID=replace-with-shop-id
YOOKASSA_SECRET_KEY=replace-with-secret-key
